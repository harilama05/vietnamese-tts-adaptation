# Copy to configs/local.env, then use absolute Linux paths for overrides.
# The runners load and export this file automatically. Shell syntax is supported.
# BASE_DIR="/absolute/path/to/g-omnivoice-finetune"
# VENV_DIR="/absolute/path/to/g-omnivoice-finetune/.venv"
# OMNIVOICE_REPO="/absolute/path/to/OmniVoice"
# CSV="/absolute/path/to/combined_train_shuffled.csv"
GPU_IDS=0
GPU_ID=0
STEPS=17500
NJ_PER_GPU=3
# AUDIO_FALLBACK_ROOT="/mnt/corpus"
# REF_AUDIO="/absolute/path/to/ref04.wav"
# REF_TEXT_FILE="/absolute/path/to/ref04.txt"
# FULL_MODEL="/absolute/path/to/checkpoint-17500"
# EVAL_RESULT_ROOT="/absolute/path/to/new_evaluation_output"
# CPU_SET must be inside the CPU affinity allocated to your job.
CPU_SET=0-7
CPU_CORES=8
